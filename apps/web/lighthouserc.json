{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3100/",
        "http://localhost:3100/report",
        "http://localhost:3100/map",
        "http://localhost:3100/ward",
        "http://localhost:3100/ward/101"
      ],
      "numberOfRuns": 1,
      "settings": { "preset": "perf", "formFactor": "mobile", "chromeFlags": "--no-sandbox --headless=new" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "./lhci-report" }
  }
}
