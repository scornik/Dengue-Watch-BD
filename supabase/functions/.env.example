# Local Edge Function secrets (supabase functions serve --env-file supabase/functions/.env)
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY / SUPABASE_ANON_KEY are injected automatically.
DEVICE_HASH_SALT=local-dev-salt-change-me-in-production
ALLOWED_ORIGINS=*
OTP_REQUIRED_AFTER=5
PHONE_OTP_ENABLED=false
PAID_AI_ENABLED=false
VISION_PROVIDER=anthropic
VISION_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DETECTOR_URL=
DETECTOR_TOKEN=
AI_DAILY_CAP=100
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:team@example.org
SITE_URL=http://localhost:3000
RESEND_API_KEY=
DIGEST_FROM=DengueWatch BD <digest@example.org>
