# cases worker (daily DGHS dengue figures -> case_counts)
# Required unless running with --dry-run. Use the Supabase *direct/pooler* Postgres URL.
DATABASE_URL=postgresql://postgres:password@localhost:54322/postgres
# Optional: comma-separated [kind:]url list, tried in order (kind = page | list).
# CASES_SOURCE_URLS=list:https://dghs.gov.bd/pages/heoc_dengue_v1.php,list:https://bdnews24.com/topic/dengue
# CASES_MAX_LINKS=3
# CASES_HTTP_TIMEOUT=30
# LOG_LEVEL=INFO
