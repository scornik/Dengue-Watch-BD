# DengueWatch BD — all configuration. Copy what you need:
#   apps/web/.env.local                 (web, NEXT_PUBLIC_* only)
#   supabase/functions/.env             (Edge Functions, local) / `supabase secrets set` (hosted)
#   Northflank job env                  (workers)
# Never commit real values. Never expose SERVICE_ROLE keys to the browser.

# ---------------------------------------------------------------------------
# Web (Vercel) — public, safe in the browser
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Anon / publishable key (RLS protects everything)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Canonical site URL (share links, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# MapLibre style JSON (free vector tiles). Default: OpenFreeMap "liberty".
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Web push VAPID public key (generate: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# On-device zero-shot model (Hugging Face id, ONNX weights, loaded lazily in a Web Worker)
NEXT_PUBLIC_CLIP_MODEL_ID=Xenova/clip-vit-base-patch32
# Link to the source code (AGPL-3.0 requires offering it to network users)
NEXT_PUBLIC_SOURCE_URL=https://github.com/scornik/Dengue-Watch-BD

# ---------------------------------------------------------------------------
# Supabase Edge Functions (secrets; SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY /
# SUPABASE_ANON_KEY are injected automatically by Supabase)
# ---------------------------------------------------------------------------
# Salt for device_hash = sha256(device_id + salt). Required. Long random string.
DEVICE_HASH_SALT=
# Allowed browser origins for CORS: exact scheme+host, comma-separated, no trailing slash.
# Production: https://your.domain[,https://www.your.domain]. Default "*" (local only).
ALLOWED_ORIGINS=http://localhost:3000
# Rules tier: require a verified phone after this many reports per device (default 5)
OTP_REQUIRED_AFTER=5
# Phone OTP needs an SMS provider configured in Supabase Auth (paid). When false,
# repeat reporters are not blocked; their reports go to the moderation queue first.
PHONE_OTP_ENABLED=false
# Paid screening tier (OFF by default)
PAID_AI_ENABLED=false
# Which server-side screener PAID_AI_ENABLED switches on (docs/DEPLOYMENT.md, "Vision provider"):
# model = self-hosted open-source detector (workers/detector, recommended) | gemini | anthropic (paid)
VISION_PROVIDER=model
VISION_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Self-hosted detector (P3) endpoint + bearer token
DETECTOR_URL=
DETECTOR_TOKEN=
# Hard daily cap on paid calls (Asia/Dhaka day)
AI_DAILY_CAP=100
# Web push (VAPID). Subject is a mailto: or https: URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:team@example.org
# Public site URL used in push/digest links
SITE_URL=http://localhost:3000
# Weekly digest email (Resend HTTP API; free tier). If unset, digests are only stored/logged.
RESEND_API_KEY=
DIGEST_FROM=DengueWatch BD <digest@example.org>

# ---------------------------------------------------------------------------
# Workers (Northflank cron jobs)
# ---------------------------------------------------------------------------
# Postgres connection: Supabase → Connect → "Session pooler" string (port 5432, works over IPv4)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# cases: comma-separated bulletin URLs to try (defaults built in)
CASES_SOURCE_URLS=
# satellite: composite lookback and cloud limit
LOOKBACK_DAYS=60
MAX_CLOUD_COVER=40
# thumbs: batch size per run and YuNet face model path (baked into the image)
BATCH_SIZE=50
YUNET_MODEL_PATH=/models/face_detection_yunet_2023mar.onnx
